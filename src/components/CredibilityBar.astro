---
// src/components/CredibilityBar.astro
import { getEntry } from 'astro:content';
import { pageSchemas } from '../content/config';
const home = pageSchemas.home.parse((await getEntry('pages', 'home'))!.data);
---
{home.credibility.items.length > 0 && (
  <div class="bg-cream border-y border-muted/30 px-8 py-5 text-center">
    <p class="text-pb-text/50 text-[9px] uppercase tracking-[0.25em] mb-3">{home.credibility.label}</p>
    <div class="flex justify-center items-center gap-8 flex-wrap">
      {home.credibility.items.map((item) => (
        item.url
          ? <a href={item.url} class="text-pb-text/70 text-sm hover:text-link transition-colors">{item.name}</a>
          : <span class="text-pb-text/70 text-sm">{item.name}</span>
      ))}
    </div>
  </div>
)}
