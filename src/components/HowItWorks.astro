---
// src/components/HowItWorks.astro
import SectionLabel from './SectionLabel.astro';
import { getEntry } from 'astro:content';
import { pageSchemas } from '../content/config';
const home = pageSchemas.home.parse((await getEntry('pages', 'home'))!.data);
---
<section class="bg-rich px-6 sm:px-10 py-14">
  <div class="text-center mb-10">
    <SectionLabel text={home.howItWorks.label} light />
  </div>
  <div class="flex flex-col sm:flex-row items-center sm:items-start justify-center gap-6 max-w-3xl mx-auto mb-12">
    {home.howItWorks.steps.map((step, i) => (
      <>
        {i > 0 && (
          <div class="text-muted text-2xl flex-shrink-0 rotate-90 sm:rotate-0 sm:mt-4">→</div>
        )}
        <div class="flex-1 text-center max-w-[220px]">
          <div class="w-10 h-10 bg-accent rounded-full flex items-center justify-center mx-auto mb-3 text-deep font-bold text-sm">
            {i + 1}
          </div>
          <h3 class="text-cream font-bold text-base mb-2">{step.title}</h3>
          <p class="text-muted text-sm leading-relaxed">{step.body}</p>
        </div>
      </>
    ))}
  </div>
  <div class="text-center">
    <a
      href={home.howItWorks.cta.href}
      class="font-inter inline-block bg-accent text-deep text-xs font-bold uppercase tracking-wider px-8 py-4 hover:brightness-110 transition-all"
    >
      {home.howItWorks.cta.label}
    </a>
  </div>
</section>
