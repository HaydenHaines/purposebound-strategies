---
// src/pages/index.astro
import Page from '../layouts/Page.astro';
import SectionLabel from '../components/SectionLabel.astro';
import HeroAlt from '../components/HeroAlt.astro';
import BenefitBar from '../components/BenefitBar.astro';
import HowItWorks from '../components/HowItWorks.astro';
import CredibilityBar from '../components/CredibilityBar.astro';
import QuoteBlock from '../components/QuoteBlock.astro';
import LeadMagnetForm from '../components/LeadMagnetForm.astro';
import TestimonialGrid from '../components/TestimonialGrid.astro';
import ServiceIconCard from '../components/ServiceIconCard.astro';
import { settingsSchemas, pageSchemas } from '../content/config';
import { getCollection, getEntry } from 'astro:content';

const founder = settingsSchemas.founder.parse((await getEntry('settings', 'founder'))!.data);
const leadMagnet = settingsSchemas.leadMagnet.parse((await getEntry('settings', 'leadMagnet'))!.data);
const home = pageSchemas.home.parse((await getEntry('pages', 'home'))!.data);

const testimonialEntries = await getCollection('testimonials');
const testimonials = testimonialEntries
  // Content layer's glob loader does not guarantee file enumeration order, so tie-break
  // on id for a deterministic render (featured first, then alphabetical by filename).
  .sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0) || a.id.localeCompare(b.id))
  .map(e => e.data);

const serviceEntries = await getCollection('services');
const services = serviceEntries.sort((a, b) => a.data.order - b.data.order);

---
<Page title={home.meta.title}>

  <HeroAlt />
  <BenefitBar />

  <!-- Who I Work With + The Problem — gold section with navy cards -->
  <section class="bg-accent clip-diag-bottom">
    <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto px-6 sm:px-10 pt-14 pb-4">
      <div class="bg-deep px-8 py-10">
        <SectionLabel text={home.whoIWorkWith.label} light />
        <h2 class="font-display uppercase text-cream text-3xl font-bold mb-4 leading-tight">
          {home.whoIWorkWith.headline}
        </h2>
        <p class="text-muted text-base leading-relaxed">
          {home.whoIWorkWith.body}
        </p>
      </div>
      <div class="bg-deep border-l-4 border-accent px-8 py-10">
        <SectionLabel text={home.problem.label} light />
        <h2 class="font-display uppercase text-cream text-3xl font-bold leading-tight mb-4">
          {home.problem.headline}
        </h2>
        <p class="text-muted text-base leading-relaxed">
          {home.problem.body}
        </p>
      </div>
    </div>
  </section>

  <!-- Meet Tory — white 50/50 Bergman founder block -->
  <section class="bg-cream clip-diag-top">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-0 items-stretch px-6 sm:px-10 py-16">
      <div class="overflow-hidden">
        <img
          src={`${founder.photo}`}
          alt={founder.name}
          class="w-full h-full object-cover object-top"
          loading="lazy"
        />
      </div>
      <div class="flex flex-col justify-center pl-0 pt-8 md:pt-0 md:pl-12">
        <SectionLabel text={home.meetTory.label} />
        <h2 class="font-display uppercase text-pb-text text-4xl font-bold leading-none mb-6">
          {home.meetTory.headline}
        </h2>
        <p class="text-pb-text/70 text-base leading-relaxed mb-4">
          {home.meetTory.body}
        </p>
        <blockquote class="border-l-4 border-accent pl-5 py-1 mb-8">
          <p class="text-pb-text/80 text-base font-bold italic leading-relaxed">
            {home.meetTory.quote}
          </p>
        </blockquote>
        <a
          href={home.meetTory.cta.href}
          class="font-inter inline-block bg-accent text-deep text-xs font-bold uppercase tracking-wider px-6 py-3 hover:brightness-110 transition-all self-start"
        >
          {home.meetTory.cta.label}
        </a>
      </div>
    </div>
  </section>

  <HowItWorks />

  <!-- Services — gold section, icon cards -->
  <section class="bg-accent px-6 sm:px-10 py-16">
    <div class="text-center mb-10">
      <SectionLabel text={home.services.label} />
      <h2 class="font-display uppercase text-deep text-4xl font-bold leading-none">
        {home.services.headline}
      </h2>
    </div>
    <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      {services.map((service) => (
        <ServiceIconCard
          title={service.data.title}
          tagline={service.data.tagline}
          description={service.data.description}
          whoItIsFor={service.data.whoItIsFor}
          includes={service.data.includes}
          cta={service.data.cta ?? "Let's Talk"}
          limited={service.data.limited}
          icon={service.data.icon}
        />
      ))}
    </div>
  </section>

  <CredibilityBar />

  <!-- Bold accent callout -->
  <section class="bg-accent px-6 sm:px-10 py-16 text-center">
    <p class="font-display uppercase text-deep text-3xl sm:text-5xl font-bold leading-none max-w-2xl mx-auto" style="letter-spacing: 0.02em;">
      {home.callout.headline}
    </p>
    <p class="text-deep/70 text-base mt-5 max-w-lg mx-auto leading-relaxed">
      {home.callout.body}
    </p>
  </section>

  <!-- Photo Banner -->
  <div class="bg-cream px-6 sm:px-10 py-6">
    <div class="mx-auto" style="max-width: 64rem;">
      <!-- Mobile: label + headline sit ABOVE the photo so they never cover faces -->
      <div class="sm:hidden bg-deep flex flex-col items-center text-center px-6 pt-8 pb-6">
        <p class="font-inter text-deep text-xs uppercase tracking-[0.3em] mb-4 bg-accent px-4 py-1.5 inline-block">{home.banner.label}</p>
        <p class="font-display uppercase text-cream text-3xl font-bold leading-none max-w-xl">
          {home.banner.headline}
        </p>
      </div>
      <div class="relative h-[280px] sm:h-[420px] overflow-hidden">
        <img
          src={home.banner.image}
          alt={home.banner.imageAlt}
          class="w-full h-full object-cover object-center"
          loading="lazy"
        />
        <!-- sm+: full overlay on the photo. Mobile: only the subline, pinned to the bottom edge -->
        <div class="absolute inset-0 bg-gradient-to-b from-deep/20 via-deep/70 to-deep/95 sm:via-deep/70 flex flex-col items-center justify-end text-center px-6 sm:px-10 pb-6 sm:pb-10">
          <p class="hidden sm:inline-block font-inter text-deep text-xs uppercase tracking-[0.3em] mb-4 bg-accent px-4 py-1.5">{home.banner.label}</p>
          <p class="hidden sm:block font-display uppercase text-cream text-3xl font-bold leading-none max-w-xl" style="text-shadow: 0 2px 12px rgba(0,0,0,1);">
            {home.banner.headline}
          </p>
          <p class="text-cream text-base sm:mt-4 max-w-lg" style="text-shadow: 0 1px 8px rgba(0,0,0,1);">
            {home.banner.subline}
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- What I Believe -->
  <section class="px-6 sm:px-10 py-10 max-w-2xl mx-auto">
    <SectionLabel text={home.whatIBelieve.label} />
    <QuoteBlock
      quote={home.whatIBelieve.quote}
    />
    <div class="mt-6 pl-6">
      <a
        href={home.whatIBelieve.cta.href}
        class="font-inter inline-block bg-accent text-deep text-xs font-bold uppercase tracking-wider px-8 py-4 hover:brightness-110 transition-all"
      >
        {home.whatIBelieve.cta.label}
      </a>
    </div>
  </section>

  <!-- Lead Magnet CTA -->
  <section class="bg-rich border-t-[3px] border-accent px-6 sm:px-10 py-14 text-center">
    <SectionLabel text={home.freeResource.label} light />
    <h2 class="font-display uppercase text-cream text-3xl font-bold mb-3">{leadMagnet.title}</h2>
    <p class="text-muted text-base mb-8 max-w-md mx-auto">{leadMagnet.description}</p>
    <LeadMagnetForm />
  </section>

  <TestimonialGrid testimonials={testimonials} />

</Page>
