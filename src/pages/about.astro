---
// src/pages/about.astro
import Page from '../layouts/Page.astro';
import SectionLabel from '../components/SectionLabel.astro';
import QuoteBlock from '../components/QuoteBlock.astro';
import { getEntry } from 'astro:content';
import { settingsSchemas, pageSchemas } from '../content/config';
const founder = settingsSchemas.founder.parse((await getEntry('settings', 'founder'))!.data);
const about = pageSchemas.about.parse((await getEntry('pages', 'about'))!.data);
---
<Page
  title={about.meta.title}
  description={about.meta.description}
>

  <!-- Page Hero -->
  <section class="bg-rich border-b-[3px] border-accent px-6 sm:px-10 py-16 text-center">
    <SectionLabel text={about.hero.label} light />
    <h1 class="text-cream text-4xl font-bold mb-4">{about.hero.headline}</h1>
    <p class="text-muted text-base max-w-md mx-auto leading-relaxed">
      {about.hero.subhead}
    </p>
  </section>

  <!-- Section 1: Faith Statement -->
  <section class="bg-cream px-6 sm:px-10 py-14 max-w-2xl mx-auto">
    <SectionLabel text={about.foundation.label} />
    <h2 class="text-pb-text text-2xl font-bold mb-6">
      {about.foundation.headline}
    </h2>
    <div class="space-y-4 text-pb-text/80 text-base leading-relaxed">
      {about.foundation.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <!-- Section 2: Coaching Philosophy -->
  <section class="bg-rich px-6 sm:px-10 py-14">
    <div class="max-w-2xl mx-auto">
      <SectionLabel text={about.philosophy.label} light />
      <h2 class="text-cream text-2xl font-bold mb-2">
        {about.philosophy.headline}
      </h2>
      <p class="text-muted text-base italic mb-6">{about.philosophy.subhead}</p>
      <div class="space-y-4 text-muted text-base leading-relaxed mb-8">
        {about.philosophy.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <QuoteBlock
        quote={about.philosophy.quote}
        light
      />
      <img
        src={`${about.philosophy.image}`}
        alt={about.philosophy.imageAlt}
        class="mt-10 w-full object-cover rounded-sm"
        loading="lazy"
      />
    </div>
  </section>

  <!-- Section 3: Founder Story -->
  <section class="bg-cream px-6 sm:px-10 py-14 max-w-2xl mx-auto">
    <SectionLabel text={about.story.label} />
    <div class="flex items-start gap-6 mb-2">
      <img
        src={`${founder.photo}`}
        alt={founder.name}
        class="w-24 h-24 rounded-full object-cover object-top border-2 border-accent flex-shrink-0"
      />
      <div class="self-center">
        <h2 class="text-pb-text text-2xl font-bold">{founder.name}</h2>
        <p class="text-link text-xs uppercase tracking-wider mt-1">{about.story.roles}</p>
      </div>
    </div>
    <p class="text-pb-text/60 text-sm italic mb-8 leading-relaxed">
      {about.story.tagline}
    </p>

    <div class="space-y-6 text-pb-text/80 text-base leading-relaxed">
      {about.story.intro.map((p) => <p>{p}</p>)}

      {about.story.sections.slice(0, 2).map((s) => (
        <div>
          <p class="text-accent text-[10px] uppercase tracking-[0.25em] mb-3">{s.heading}</p>
          {s.paragraphs.map((p, i) => <p class={i > 0 ? 'mt-3' : undefined}>{p}</p>)}
        </div>
      ))}

      <p>{about.story.closing}</p>

      {about.story.sections.slice(2).map((s) => (
        <div>
          <p class="text-accent text-[10px] uppercase tracking-[0.25em] mb-3">{s.heading}</p>
          {s.paragraphs.map((p, i) => <p class={i > 0 ? 'mt-3' : undefined}>{p}</p>)}
        </div>
      ))}

      <div>
        <p class="text-accent text-[10px] uppercase tracking-[0.25em] mb-3">Core Strengths</p>
        <p class="text-pb-text/70">{about.story.strengths}</p>
      </div>
    </div>

    <img
      src={`${about.story.image}`}
      alt={about.story.imageAlt}
      class="my-10 w-full object-cover rounded-sm"
      loading="lazy"
    />
    <a
      href={`${about.story.cta.href}`}
      class="font-inter inline-block bg-accent text-deep text-xs font-bold uppercase tracking-wider px-6 py-3 hover:brightness-110 transition-all"
    >
      {about.story.cta.label}
    </a>
  </section>

</Page>
